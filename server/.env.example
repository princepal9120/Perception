# ===========================================
# Perception AI Chat API - Environment Variables
# ===========================================

# App Configuration
APP_NAME="Perception AI Chat API"
APP_VERSION="1.0.0"
DEBUG=false
ENABLE_DOCS=true

# Security - CHANGE THESE IN PRODUCTION!
SECRET_KEY=your-super-secret-key-change-this-in-production-min-32-characters
SESSION_SECRET_KEY=your-session-secret-key-change-this-in-production
ALGORITHM=HS256

# Pinecone (Vector Database)
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_INDEX_NAME=perception

# Token Expiration
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Search API
TAVILY_API_KEY=your-tavily-api-key-here

# Database (Neon.tech PostgreSQL)
# Format: postgresql+asyncpg://user:password@host/database?sslmode=require
DATABASE_URL=postgresql+asyncpg://username:password@your-neon-host.neon.tech/neondb?sslmode=require

# Database Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Redis (Optional - app works without it)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Rate Limiting
RATE_LIMIT_MESSAGES_PER_MINUTE=20
RATE_LIMIT_WINDOW_SECONDS=60

# Cache Settings
CACHE_MAX_MESSAGES=100
SESSION_CACHE_TTL=3600

# CORS Origins (comma-separated for production)
# CORS Origins (comma-separated, add your production frontend URL)
CORS_ORIGINS=https://perception.princepal.dev,http://localhost:3000,http://localhost:5173,http://localhost:8080

# LLM Configuration
GROQ_API_KEY=your-groq-api-key-here

# Validation Settings
MIN_USERNAME_LENGTH=3
MAX_USERNAME_LENGTH=30
MIN_PASSWORD_LENGTH=8
MAX_PASSWORD_LENGTH=100
UPSTASH_REDIS_REST_URL="your-upstash-redis-url"
UPSTASH_REDIS_REST_TOKEN="your-upstash-redis-token"

# API Keys
GOOGLE_API_KEY=your-google-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-api-key-here
PERPLEXITY_API_KEY=your-perplexity-api-key-here
GITHUB_TOKEN=your-github-token-here

# Clerk Authentication
CLERK_SECRET_KEY=your-clerk-secret-key-here
CLERK_PUBLISHABLE_KEY=your-clerk-publishable-key-here
