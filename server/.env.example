# Perception OSS backend configuration

APP_NAME="Perception API"
APP_VERSION="1.0.0"
DEBUG=true
ENABLE_DOCS=true

# Local-first OSS defaults
AUTH_MODE=disabled
MODEL_PROVIDER=openai_compatible
EMBEDDING_PROVIDER=openai_compatible
SEARCH_PROVIDER=duckduckgo

# Security
SECRET_KEY=replace-this-with-a-long-random-string
SESSION_SECRET_KEY=replace-this-with-a-long-random-string
ALGORITHM=HS256

# Local OSS demo identity
LOCAL_DEV_USER_NAME="Local OSS User"
LOCAL_DEV_USER_EMAIL=local@perception.dev
LOCAL_DEV_TOKEN=perception-local-dev-token

# Database
DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/perception
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Redis / Upstash (optional)
REDIS_URL=redis://localhost:6379
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# OpenAI-compatible model path
OPENAI_API_KEY=replace-me
OPENAI_API_BASE_URL=http://localhost:11434/v1
OPENAI_MODEL=qwen2.5:14b-instruct
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional alternative providers
GOOGLE_API_KEY=
GROQ_API_KEY=
TAVILY_API_KEY=

# Optional integrations
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
ELEVENLABS_API_KEY=
ALPHA_VANTAGE_API_KEY=
PERPLEXITY_API_KEY=
GITHUB_TOKEN=

# Documents / vector settings
PINECONE_API_KEY=
PINECONE_INDEX_NAME=perception
UPLOAD_DIR=uploads
FAISS_INDEX_DIR=faiss_index
